<div class="page-width">
  <div class="page-title"><h1>{{ 'cart.title' | t }}</h1></div>
  {%- if cart.item_count == 0 -%}
    <div class="empty"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      <table class="cart-table">
        <thead><tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td class="cart-cell--product"><div class="cart-item">
                {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}{%- endif -%}
                <div><a href="{{ item.url }}">{{ item.product.title }}</a>{%- unless item.product.has_only_default_variant -%}<br><small>{{ item.variant.title }}</small>{%- endunless -%}<br><small><a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></small></div>
              </div></td>
              <td class="cart-cell cart-cell--price" data-label="Price">{{ item.final_price | money }}</td>
              <td class="cart-cell cart-cell--qty" data-label="Qty"><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:70px;padding:8px;font:inherit"></td>
              <td class="cart-cell cart-cell--total" data-label="Total">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      <div class="cart-summary">
        <div>{{ 'cart.subtotal' | t }}</div>
        <div class="cart-summary__total">{{ cart.total_price | money }}</div>
        <p><small>{{ 'cart.note' | t }}</small></p>
        <button class="button button--ghost" type="submit" name="update">Update</button>
        <button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {%- endif -%}
</div>
<div style="height:88px"></div>
{% schema %}{ "name": "Cart" }{% endschema %}

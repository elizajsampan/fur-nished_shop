<div class="story-page" {{ section.shopify_attributes }}>

  <section class="story-hero">
    {%- if section.settings.banner_image != blank -%}
      {{ section.settings.banner_image | image_url: width: 2400 | image_tag: class: 'story-hero__img', widths: '800, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', alt: '' }}
    {%- else -%}
      <img class="story-hero__img" src="{{ 'slide-1.jpg' | asset_url }}" alt="" width="1200" height="1200" loading="eager">
    {%- endif -%}
    <div class="page-width story-hero__inner">
      <span class="eyebrow">{{ page.title }}</span>
      <h1>{{ section.settings.headline }}</h1>
    </div>
  </section>

  <section class="section story-intro">
    <div class="page-width">
      <p class="story-intro__text">{{ section.settings.statement }}</p>
      {%- if section.settings.show_page_content -%}<div class="story-body">{{ page.content }}</div>{%- endif -%}
    </div>
  </section>

  <section class="story-mosaic-wrap">
    <div class="page-width story-mosaic">
      <figure class="story-mosaic__tall">
        {%- if section.settings.image_1 != blank -%}
          {{ section.settings.image_1 | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', alt: '' }}
        {%- else -%}
          <img src="{{ 'story.jpg' | asset_url }}" alt="" width="736" height="977" loading="lazy">
        {%- endif -%}
        <figcaption>{{ section.settings.caption_1 }}</figcaption>
      </figure>
      <figure class="story-mosaic__wide">
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', alt: '' }}
        {%- else -%}
          <img src="{{ 'slide-3.jpg' | asset_url }}" alt="" width="1000" height="638" loading="lazy">
        {%- endif -%}
        <figcaption>{{ section.settings.caption_2 }}</figcaption>
      </figure>
      <div class="story-mosaic__note">
        <span class="eyebrow">{{ section.settings.note_eyebrow }}</span>
        <p>{{ section.settings.note_text }}</p>
      </div>
    </div>
  </section>

  {%- if section.blocks.size > 0 -%}
  <section class="section surface">
    <div class="page-width">
      <div class="section-head section-head--center"><h2>{{ section.settings.values_heading }}</h2></div>
      <div class="story-values">
        {%- for block in section.blocks -%}
          <div class="story-value" {{ block.shopify_attributes }}>
            <span class="story-value__num">0{{ forloop.index }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  <section class="section story-cta">
    <div class="page-width">
      {%- if section.settings.quote != blank -%}<p class="story-cta__quote">{{ section.settings.quote }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "image_picker", "id": "banner_image", "label": "Banner image (defaults to theme image)" },
    { "type": "text", "id": "headline", "label": "Banner headline", "default": "Good design should have nine lives." },
    { "type": "textarea", "id": "statement", "label": "Opening statement", "default": "We started Fur-nished with one question: what if pet furniture looked like actual furniture?" },
    { "type": "checkbox", "id": "show_page_content", "label": "Also show the page's own text (from the Pages editor)", "default": false },
    { "type": "image_picker", "id": "image_1", "label": "Tall image (defaults to theme image)" },
    { "type": "text", "id": "caption_1", "label": "Tall image caption", "default": "Walnut cat pod" },
    { "type": "image_picker", "id": "image_2", "label": "Wide image (defaults to theme image)" },
    { "type": "text", "id": "caption_2", "label": "Wide image caption", "default": "Oak scratcher lounger" },
    { "type": "text", "id": "note_eyebrow", "label": "Note label", "default": "Made for modern homes" },
    { "type": "textarea", "id": "note_text", "label": "Note text", "default": "Designed for discerning felines, and built to blend into your living room." },
    { "type": "text", "id": "values_heading", "label": "Values heading", "default": "What we stand for" },
    { "type": "text", "id": "quote", "label": "Closing line", "default": "Because a house isn't truly a home until it's Fur-nished." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Furniture first" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Pieces that look at home in a living room." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Our story" }]
}
{% endschema %}

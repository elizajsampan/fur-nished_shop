{%- liquid
  assign filled = 0
  for block in section.blocks
    if block.settings.quote != blank
      assign filled = filled | plus: 1
    endif
  endfor
-%}
{%- if filled > 0 or request.design_mode -%}
<section class="section reviews" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head section-head--center">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="reviews__grid" style="--cols:{{ filled | at_least: 1 | at_most: 3 }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.quote != blank -%}
          <figure class="review" {{ block.shopify_attributes }}>
            <div class="review__stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}" aria-hidden="true">&#9733;</span>{%- endfor -%}
            </div>
            <blockquote>{{ block.settings.quote }}</blockquote>
            <figcaption>{{ block.settings.name }}{% if block.settings.detail != blank %}<span>{{ block.settings.detail }}</span>{% endif %}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if filled == 0 -%}<p class="reviews__hint">Add a real customer review to each block. This strip stays hidden on the live store until one has text.</p>{%- endif -%}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by cats" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote (use a real customer review)" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "detail", "label": "Detail (e.g. city or product)" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}

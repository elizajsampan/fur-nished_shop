<div class="page-width">
  <div class="page-title"><h1>{{ 'general.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter" style="margin-top:1rem">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search">
      <button class="button" type="submit">Go</button>
    </form>
  </div>
  {%- paginate search.results by 12 -%}
    {%- if search.performed and search.results_count == 0 -%}<p class="empty">No results for &ldquo;{{ search.terms }}&rdquo;.</p>{%- endif -%}
    <div class="grid" style="--cols:3">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}
        {%- else -%}<a class="card" href="{{ item.url }}"><h3 class="card__title">{{ item.title }}</h3></a>{%- endif -%}
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</div>
<div style="height:88px"></div>
{% schema %}{ "name": "Search" }{% endschema %}

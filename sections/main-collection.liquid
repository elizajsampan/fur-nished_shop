<div class="page-width">
  <div class="page-title">
    <span class="eyebrow">Collection</span>
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<p>{{ collection.description }}</p>{%- endif -%}
  </div>
  {%- paginate collection.products by section.settings.per_page -%}
    <div class="toolbar">
      <span>{{ collection.products_count }} {{ collection.products_count | pluralize: 'piece', 'pieces' }}</span>
      <label>Sort
        <select onchange="window.location.search='sort_by='+this.value">
          {%- assign sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- for o in collection.sort_options -%}<option value="{{ o.value }}" {% if o.value == sort %}selected{% endif %}>{{ o.name }}</option>{%- endfor -%}
        </select>
      </label>
    </div>
    {%- if collection.products.size == 0 -%}
      <p class="empty">No products found.</p>
    {%- else -%}
      <div class="grid" style="--cols:{{ section.settings.columns }}">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr; Prev</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
<div style="height:88px"></div>
{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 24, "step": 3, "default": 12 }
  ]
}
{% endschema %}

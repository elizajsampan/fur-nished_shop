<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="section-head section-head--center"><h2>{{ section.settings.heading }}</h2></div>{%- endif -%}
    <div class="features">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          <span class="feature__icon">{{ block.settings.icon }}</span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Features",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for the way cats live" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Symbol", "default": "✦" },
        { "type": "text", "id": "title", "label": "Title", "default": "Solid, sustainable wood" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Responsibly sourced oak and walnut, finished with pet-safe oils." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Features",
      "blocks": [
        { "type": "feature", "settings": { "icon": "✦", "title": "Solid, sustainable wood", "text": "Responsibly sourced oak and walnut, finished with pet-safe, non-toxic oils." } },
        { "type": "feature", "settings": { "icon": "❋", "title": "Washable cushions", "text": "Removable, machine-washable covers keep every nest fresh." } },
        { "type": "feature", "settings": { "icon": "◌", "title": "Cat-approved comfort", "text": "Sized and shaped by how cats curl, perch and hide." } }
      ]
    }
  ]
}
{% endschema %}

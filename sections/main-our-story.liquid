<section class="story-page" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="page-title page-title--compact">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}<p class="story-page__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- liquid
      assign fallback = 'story-' | append: block.settings.fallback | append: '.jpg'
      assign reverse = false
      assign rem = forloop.index | modulo: 2
      if rem == 0
        assign reverse = true
      endif
    -%}
    <div class="story-row" {{ block.shopify_attributes }}>
      <div class="page-width split{% if reverse %} split--reverse{% endif %}">
        <div class="split__media story__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'split__img', loading: 'lazy', widths: '600, 900, 1200', alt: block.settings.heading }}
          {%- else -%}
            <img class="split__img" src="{{ fallback | asset_url }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        <div>
          <span class="eyebrow">{{ block.settings.eyebrow }}</span>
          <h2>{{ block.settings.heading }}</h2>
          <p class="story-row__text">{{ block.settings.text }}</p>
          <ul class="story-row__list">
            {%- for i in (1..3) -%}
              {%- assign key = 'point' | append: i -%}
              {%- assign point = block.settings[key] -%}
              {%- if point != blank -%}<li>{{ point }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.button_label != blank -%}
            <a class="button button--ghost" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}
</section>
{% schema %}
{
  "name": "Our story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Furniture first. Cat gear never." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Your home shouldn't have to choose between design and the cat who rules it. Every piece is made to be displayed, and loved." }
  ],
  "blocks": [
    {
      "type": "collection_row",
      "name": "Collection row",
      "settings": [
        { "type": "select", "id": "fallback", "label": "Default image", "default": "beds", "options": [
          { "value": "beds", "label": "Cat bed" },
          { "value": "furniture", "label": "Furniture" },
          { "value": "scratchers", "label": "Scratcher" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Image (overrides default)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Cat beds" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Naps, upgraded." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Clean silhouettes and cloud-soft cushions." },
        { "type": "text", "id": "point1", "label": "Point 1" },
        { "type": "text", "id": "point2", "label": "Point 2" },
        { "type": "text", "id": "point3", "label": "Point 3" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop cat beds" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Our story" }]
}
{% endschema %}

<section class="section surface" {{ section.shopify_attributes }}>
  <div class="page-width split {% if section.settings.reverse %}split--reverse{% endif %}">
    <div class="split__media story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'split__img', loading: 'lazy', widths: '600, 900, 1200' }}
      {%- else -%}
        <img class="split__img" src="{{ 'story.jpg' | asset_url }}" alt="" width="736" height="977" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="story__text">{{ section.settings.text }}</div>
      <ul class="story__points">
        {%- for i in (1..3) -%}
          {%- liquid
            assign t_key = 'point' | append: i | append: '_title'
            assign d_key = 'point' | append: i | append: '_text'
            assign title = section.settings[t_key]
            assign desc = section.settings[d_key]
          -%}
          {%- if title != blank -%}
            <li><span class="story__num">0{{ i }}</span><div><h3>{{ title }}</h3><p>{{ desc }}</p></div></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.button_label != blank -%}<a class="button button--ghost" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (defaults to theme image)" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Furniture first. Cat gear never." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Your home shouldn't have to choose between design and the cat who rules it.</p>" },
    { "type": "text", "id": "point1_title", "label": "Point 1 title", "default": "Solid wood, hand finished" },
    { "type": "textarea", "id": "point1_text", "label": "Point 1 text", "default": "Oak and walnut with pet-safe oils." },
    { "type": "text", "id": "point2_title", "label": "Point 2 title", "default": "Sized for real cats" },
    { "type": "textarea", "id": "point2_text", "label": "Point 2 text", "default": "Shaped around how cats curl and climb." },
    { "type": "text", "id": "point3_title", "label": "Point 3 title", "default": "Designed to be displayed" },
    { "type": "textarea", "id": "point3_text", "label": "Point 3 text", "default": "Clean lines that belong in your living room." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}

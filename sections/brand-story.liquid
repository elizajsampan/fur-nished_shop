<section class="section surface" {{ section.shopify_attributes }}>
  <div class="page-width split {% if section.settings.reverse %}split--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'split__img', loading: 'lazy', widths: '600, 900, 1200' }}
      {%- else -%}
        <img class="split__img" src="{{ 'story.jpg' | asset_url }}" alt="" width="736" height="977" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div>{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a class="button button--ghost" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (defaults to theme image)" },
    { "type": "checkbox", "id": "reverse", "label": "Image on right", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our philosophy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Furniture first. Cat gear never." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Your home shouldn't have to choose between design and the cat who rules it. Every Fur-nished piece is shaped from solid wood and bentwood veneer, finished by hand, and sized for real cats, so the nook they love is one you'll be proud to display.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}

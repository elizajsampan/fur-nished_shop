<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-head">
      <div>
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.collection != blank -%}<a class="link-arrow" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="grid" style="--cols:{{ section.settings.columns }}">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="card"><div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div><h3 class="card__title">Example product</h3><div class="card__price">$0.00</div></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces they'll claim as their own" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}

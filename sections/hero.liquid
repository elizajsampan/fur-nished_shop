<section class="hero" {{ section.shopify_attributes }}>
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'hero__img', widths: '800, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', alt: section.settings.heading }}
  {%- else -%}
    <img class="hero__img" src="{{ 'hero.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="736" height="981" loading="eager">
  {%- endif -%}
  <div class="page-width" style="width:100%">
    <div class="hero__content">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero__buttons">
        {%- if section.settings.button_label != blank -%}<a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.button2_label != blank -%}<a class="button button--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (defaults to theme image)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "European modern" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Elevated living for cats and their humans." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sculptural, solid-wood furniture your cat will claim and your living room will love." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label", "default": "Our story" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
